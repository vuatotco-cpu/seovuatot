# Supabase - Lấy từ https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API - Lấy từ https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini - Lấy từ https://aistudio.google.com/app/apikey (miễn phí)
GEMINI_API_KEY=AIza...

# Groq - Llama 3.1 70B miễn phí siêu nhanh - Lấy từ https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenAI GPT-4o + DALL-E 3 - Lấy từ https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# DeepSeek - Lấy từ https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Stability AI - Lấy từ https://platform.stability.ai
STABILITY_API_KEY=sk-...

# Unsplash - Lấy từ https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-access-key

# DataForSEO - Lấy từ https://dataforseo.com
DATAFORSEO_LOGIN=your-email@example.com
DATAFORSEO_PASSWORD=your-password

# Google Search Console - Lấy từ https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
